# Usuário público do TryHackMe (parte final de https://tryhackme.com/p/<USERNAME>)
THM_USERNAME=CyberOwl

# URL do Webhook do Discord (Configurações do Canal -> Integrações -> Webhooks)
# Deixe vazio para apenas exibir no terminal e salvar o arquivo JSON localmente.
DISCORD_WEBHOOK_URL=

# Caminho do arquivo JSON gerado
THM_OUTPUT_FILE=tryhackme_profile.json

# Quantidade máxima de salas concluídas a paginar (0 = buscar todas)
THM_MAX_ROOMS=500
